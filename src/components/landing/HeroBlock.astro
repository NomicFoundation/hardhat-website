---
import { getCollection } from "astro:content";
import Button from "../ui/Button.astro";
import Container from "./Container.astro";
import heroGraphicDesktop from "../../assets/landing/hero/hero.webp";
import heroGraphicTablet from "../../assets/landing/hero/heroTablet.webp";
import heroGraphicMobile from "../../assets/landing/hero/heroMobile.webp";
import heroGraphicDesktopDark from "../../assets/landing/hero/heroDark.webp";
import heroGraphicDarkTablet from "../../assets/landing/hero/heroDarkTablet.webp";
import heroGraphicDarkMobile from "../../assets/landing/hero/heroDarkMobile.webp";

import { landing } from "../../config";
import { formatSmartDate } from "../../utils/formatSmartDate";
import { releaseSummaryHtml } from "../../utils/releaseSummary";

const githubReleases = await getCollection("githubReleases");
const latestRelease = githubReleases[0];
---

<section class="section">
  <Container>
    <div class="content">
      <span class="tagline" set:html={landing.hero.tagline} />
      <h1 class="title">{landing.hero.title}</h1>
      <Button href={landing.hero.cta.url} variant="lg">
        {landing.hero.cta.title}
      </Button>
    </div>

    {
      latestRelease && (
        <div class="release-info">
          <a
            href={latestRelease.data.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="release-version"
          >
            {latestRelease.data.name}
          </a>
          <p class="release-description">
            Released {formatSmartDate(latestRelease.data.published_at)}:{" "}
            <Fragment set:html={releaseSummaryHtml(latestRelease.data.body)} />
          </p>
        </div>
      )
    }
  </Container>

  <div class:list={["graphic-container", "light"]}>
    <picture>
      <source media="(max-width: 767px)" srcset={heroGraphicMobile.src} />
      <source media="(max-width: 1199px)" srcset={heroGraphicTablet.src} />
      <img
        src={heroGraphicDesktop.src}
        alt=""
        role="presentation"
        loading="eager"
        decoding="sync"
      />
    </picture>
  </div>

  <div class:list={["graphic-container", "dark"]}>
    <picture>
      <source media="(max-width: 767px)" srcset={heroGraphicDarkMobile.src} />
      <source media="(max-width: 1199px)" srcset={heroGraphicDarkTablet.src} />
      <img
        src={heroGraphicDesktopDark.src}
        alt=""
        role="presentation"
        loading="eager"
        decoding="sync"
      />
    </picture>
  </div>
</section>

<style lang="sass">
  @use '../../styles/mixins' as *

  .section
    width: 100%
    padding: 28px 0 100px
    text-align: center
    position: relative
    z-index: 1
    color: var(--hh-gray900)

    +dark
      color: var(--hh-gray200)

    +tablet
      padding: 70px 0 120px

    +laptop
      padding: 102px 0 200px

    +desktop
      padding: 102px 0 240px

    &::before
      background-image: url('../../assets/landing/hero/hero-texture.svg')
      +dark
        background-image: url('../../assets/landing/hero/heroDark-texture.svg')

      +tablet
        content: ""
        position: absolute
        top: 0
        left: 0
        width: 100%
        height: 100%
        background-size: auto 100%
        background-position: top center
        z-index: -1
        pointer-events: none

      +desktop
        top: 40px

  .content
    width: 100%
    display: flex
    flex-direction: column
    align-items: center
    gap: 22px
    max-width: 520px
    margin: 0 auto

    +tablet
      gap: 24px

    +laptop
      padding-top: 60px
      max-width: 730px
      gap: 40px

    +desktop
      max-width: 840px

    :global(.cta.lg)
      font-size: 12px
      height: 42px
      padding-inline: 20px
      +tablet
        height: 44px
        padding-inline: 28px

      +laptop
        height: 56px
        font-size: 16px

  .graphic-container
    height: auto
    position: absolute
    top: -33px
    left: 50%
    width: 993px
    pointer-events: none
    transform: translateX(-50%)
    z-index: -1
    +tablet
      top: 42px
      width: 1165px

    +laptop
      top: 15px
      width: 1743px

    +desktop
      top: 96px
      width: 1831px
      left: calc(50% - 1px)

    picture
      display: block
      width: 100%
      height: 100%

    img
      width: 100%

    &:global(.light)
      display: flex

      +dark
        display: none

    &:global(.dark)
      display: none

      +dark
        display: flex

  .tagline
    font-family: var(--font-code)
    font-size: 16px
    line-height: 1.4
    letter-spacing: 0.05em

    +tablet
      font-size: 20px

    +laptop
      font-size: 25px

    +desktop
      font-size: 31px

    :global(strong)
      display: block
      font-size: 18px
      margin-bottom: 4px
      +tablet
        display: inline
        font-size: inherit

  .title
    font-size: 39px
    line-height: 1
    letter-spacing: 0.045em
    font-family: var(--font-base)
    font-weight: 700
    margin: 0

    +tablet
      font-size: 61px
      line-height: 1.05
    +laptop
      font-size: 76px
      line-height: 1

    +desktop
      font-size: 95px
      letter-spacing: 0.02em

  .release-info
    display: flex
    flex-direction: column
    align-items: center
    gap: 6px
    width: 100%
    max-width: 100%
    margin: 310px auto 0
    font-family: var(--font-code)
    letter-spacing: 0.05em
    text-align: center
    color: var(--hh-gray600)
    position: relative
    z-index: 2

    +dark
      color: var(--hh-gray500)

    +tablet
      margin-top: 44px
      max-width: 560px

    +laptop
      margin-top: 56px
      max-width: 660px

    +desktop
      margin-top: 60px
      max-width: 760px

  .release-version,
  .release-description :global(a)
    color: inherit
    text-decoration: underline
    text-underline-offset: 2px

    &:hover
      color: var(--hh-gray900)

      +dark
        color: var(--hh-gray200)

  .release-version
    font-weight: 600
    font-size: 11px
    line-height: 1.3

    +tablet
      font-size: 12px

    +laptop
      font-size: 13px

    +desktop
      font-size: 14px

  .release-description
    margin: 0
    max-width: 100%
    font-weight: 400
    font-size: 9px
    line-height: 1.4
    white-space: nowrap
    overflow: hidden
    text-overflow: ellipsis

    +tablet
      font-size: 10px

    +laptop
      font-size: 11px

    +desktop
      font-size: 12px
</style>
